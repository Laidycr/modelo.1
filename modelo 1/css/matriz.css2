nav ul {
}

nav li {
    margin: 0 10px;
}

nav a {
    text-decoration: none;
    color: black;
    font-weight: bold;
    padding: 10px 15px;
}

nav a:hover {
    background-color: #d2e23e;
    color: rgb(221, 29, 15);
}

h2 {
    font-size: 18px;
    font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
    font-weight: bold;
}

h2:hover {
    font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
    font-weight: bold;
    
}